# Environment files (prevent secret leaks into Docker images)
.env
.env.*
!.env.example

# Dependencies
node_modules

# Git
.git
.gitignore

# Next.js build artifacts
.next
out

# Agent/IDE configuration
.agent
.commandcode
.planning

# Scripts (not needed in production image)
scripts/

# Prisma migrations (not needed in runtime)
prisma/migrations
prisma/seed.ts

# Standalone scripts (not part of Next.js app)
seed-users.ts

# Test files
src/__tests__/
vitest.config.ts

# Markdown/docs (keep README for health check reference)
*.md
!README.md

# Cache & temp
*.cache
*.tmp
*.log
